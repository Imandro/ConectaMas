# Configuración de base de datos
# OPCIÓN GRATIS (Recomendada): Usa Supabase (PostgreSQL) o Vercel Postgres
# Obtén tu URL en supabase.com o vercel.com/storage
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# OPCIÓN LOCAL (Solo para desarrollo):
# DATABASE_URL="file:./dev.db"

# Configuración de Autenticación (NextAuth)
# IMPORTANTE: Genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET="tu_secreto_super_seguro_aqui"

# URL de la aplicación
# En local: http://localhost:3000
# En producción: https://tu-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Web Push Notifications (VAPID)
# Genera tus llaves con: npx web-push generate-vapid-keys
