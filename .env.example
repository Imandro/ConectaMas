# Configuración de base de datos
# OPCIÓN GRATIS (Recomendada): Usa Supabase (PostgreSQL) o Vercel Postgres
# Obtén tu URL en supabase.com o vercel.com/storage
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# OPCIÓN LOCAL (Solo para desarrollo):
# DATABASE_URL="file:./dev.db"

# Configuración de Autenticación (NextAuth)
# IMPORTANTE: Genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET="tu_secreto_super_seguro_aqui"

# URL de la aplicación
# En local: http://localhost:3000
# En producción: https://tu-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="https://conectamas.app"

# Server-only AI chat configuration. Never use NEXT_PUBLIC_ for these values.
NVIDIA_API_KEY=""
NVIDIA_API_URL="https://integrate.api.nvidia.com/v1/chat/completions"
NVIDIA_MODEL="nvidia/llama-3.3-nemotron-super-49b-v1"

# Secreto para disparar endpoint de lotes de notificaciones.
# Usa NOTIFICATIONS_ENGINE_SECRET o CRON_SECRET; nunca lo envíes en URL.
NOTIFICATIONS_ENGINE_SECRET="otro_secreto_largo_y_aleatorio"

# Web Push Notifications (VAPID)
# Genera tus llaves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BGBZ1Q1LwyPolkAPnshPKwQ6NNijzuu8_lqDziuABVb6z60pX1uwKsw1jgO-rCabt5QIf_90OSNqNRgXKti9zyI"
VAPID_PRIVATE_KEY="tu_clave_privada_vapid"
VAPID_SUBJECT="mailto:admin@conectaplus.app"

# Billing: production must remain disabled until merchant accounts and payouts are verified.
BILLING_WEB_ENABLED="false"
BILLING_PLAY_ENABLED="false"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_PREMIUM_MONTHLY_PLAN_ID=""
PAYPAL_SUPPORT_MONTHLY_PLAN_ID=""
PAGADITO_UID=""
PAGADITO_WSK=""
PAGADITO_ENVIRONMENT="sandbox"
PAGADITO_CERT_HOSTS=""
GOOGLE_PLAY_PACKAGE_NAME="com.conecta_plus.app"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_PLAY_PUBSUB_AUDIENCE=""
