{
    "name": "conecta-plus",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "next lint",
        "postinstall": "prisma generate",
        "db:seed": "ts-node prisma/seed.ts",
        "db:migrate:deploy": "prisma migrate deploy",
        "notifications:worker": "ts-node --transpile-only scripts/run-notifications-worker.ts",
        "test:offline": "node scripts/test-offline-policy.js && node scripts/test-offline-routes.js",
        "test:sync-queue": "node scripts/test-sync-queue.js",
        "test:sync-integration": "node scripts/test-sync-integration.js",
        "test:notification-batch": "node scripts/test-notification-batch.js",
        "test:idempotency": "node scripts/run-idempotency-test.cjs",
        "test:scalability": "node scripts/test-scalability-guards.js",
        "test:billing": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-billing-domain.ts",
        "test:billing:schema": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-billing-schema.ts",
        "test:billing:providers": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-billing-providers.ts",
        "test:billing:webhooks": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-billing-webhooks.ts",
        "test:billing:google": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-billing-google-play.ts",
        "test:billing:security": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-billing-security.ts",
        "test:android-release": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-android-release-config.ts",
        "test:legal": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-legal-policy.ts",
        "test:data-rights": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-data-rights.ts",
        "test:legal:consent": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-legal-consent.ts",
        "test:email-validation": "ts-node --project tsconfig.scripts.json --transpile-only scripts/test-email-validation.ts"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.7.4",
        "@capacitor/core": "^8.5.3",
        "@capgo/native-purchases": "^8.9.6",
        "@prisma/client": "^5.22.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@vercel/analytics": "^1.6.1",
        "bcryptjs": "^2.4.3",
        "bootstrap": "^5.3.2",
        "downloadjs": "^1.4.7",
        "framer-motion": "^10.16.16",
        "html-to-image": "^1.11.13",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^0.303.0",
        "next": "^14.2.21",
        "next-auth": "5.0.0-beta.25",
        "next-pwa": "^5.6.0",
        "pwabuilder-android": "^2.0.0-rc.3",
        "pwabuilder-lib": "^2.1.12",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-easy-crop": "^5.5.6",
        "react-hot-toast": "^2.6.0",
        "sass": "^1.69.7",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@bubblewrap/core": "^1.24.1",
        "@pwabuilder/cli": "^0.0.17",
        "@types/bcryptjs": "^2.4.6",
        "@types/downloadjs": "^1.4.6",
        "@types/node": "^20.10.6",
        "@types/react": "^18.2.46",
        "@types/react-dom": "^18.2.18",
        "@types/web-push": "^3.6.4",
        "eslint": "^8.56.0",
        "eslint-config-next": "^14.2.21",
        "prisma": "^5.22.0",
        "protobufjs": "^8.6.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
