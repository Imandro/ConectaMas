generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(cuid())
  email                    String?                @unique
  passwordHash             String?
  name                     String?
  role                     String                 @default("USER")
  username                 String?                @unique
  securityAnswer           String?
  isAnonymous              Boolean                @default(false)
  gender                   String?
  spiritualStatus          String?
  sinsToOvercome           String?
  problemsFaced            String?
  connectionMethods        String?
  spiritualLevel           String                 @default("Explorador")
  hasCompletedOnboarding   Boolean                @default(false)
  hasSeenTutorialTour      Boolean                @default(false)
  hasSeenLlamiTutorial     Boolean                @default(false)
  hasSeenCommunityTutorial Boolean                @default(false)
  leaderPhone              String?
  age                      Int?
  lastUsernameChange       DateTime?
  lastForumCheck           DateTime?              @default(now())
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  isCounselor              Boolean                @default(false)
  isPremium                Boolean                @default(false)
  hasJoinedWhatsapp        Boolean                @default(false)
  hasFollowedInstagram     Boolean                @default(false)
  country                  String?                @default("AR")
  lastChallengeCompleted   DateTime?
  preferredLanguage        String                 @default("es")
  region                   String                 @default("LATAM")
  bio                      String?
  league                   String                 @default("BRONZE")
  profileType              String                 @default("NORMAL")
  totalXP                  Int                    @default(0)
  weeklyXP                 Int                    @default(0)
  accounts                 Account[]
  answers                  Answer[]
  answerLikes              AnswerLike[]
  checkins                 DailyCheckin[]
  forumNotifications       ForumNotification[]
  forumPosts               ForumPost[]
  forumReplies             ForumReply[]
  receivedRequests         Friendship[]           @relation("ReceivedRequests")
  sentRequests             Friendship[]           @relation("SentRequests")
  gameParticipations       GamePlayer[]
  gameScores               GameScore[]
  ledGroups                Group[]                @relation("GroupLeader")
  groupMemberships         GroupMember[]
  groupTaskCompletions     GroupTaskCompletion[]
  journalEntries           JournalEntry[]
  leaderApplications       LeaderApplication[]
  mascot                   Mascot?
  prayerRequests           PrayerRequest[]
  prayerUpdates            PrayerUpdate[]
  pushSubscriptions        PushSubscription[]
  questions                Question[]
  questionLikes            QuestionLike[]
  sessions                 Session[]
  streak                   Streak?
  receivedSupport          SupportMessage[]       @relation("ReceivedSupport")
  sentSupport              SupportMessage[]       @relation("SentSupport")
  completedDevotionals     UserDevotional[]
  struggles                UserStruggle[]
  readingProgress          ReadingProgress?
  triviaAttempts           UserTriviaAttempt[]
  watchedVideos            UserVideo[]
  friends                  User[]                 @relation("UserFriends")
  symmetricFriends         User[]                 @relation("UserFriends")
}

model SupportMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  message    String
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)
  receiver   User     @relation("ReceivedSupport", fields: [receiverId], references: [id])
  sender     User     @relation("SentSupport", fields: [senderId], references: [id])
}

model UserDevotional {
  id           String   @id @default(cuid())
  userId       String
  devotionalId String
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, devotionalId])
}

model UserStruggle {
  id            String    @id @default(cuid())
  userId        String
  title         String
  status        String    @default("ACTIVE")
  startDate     DateTime  @default(now())
  lastRelapse   DateTime?
  currentDay    Int       @default(1)
  completedDays String    @default("")
  isStarted     Boolean   @default(false)
  gravity       Int       @default(5)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, title])
}

model StrugglePlan {
  id          String            @id @default(cuid())
  title       String            @unique
  description String?
  createdAt   DateTime          @default(now())
  days        StrugglePlanDay[]
}

model StrugglePlanDay {
  id                  String       @id @default(cuid())
  planId              String
  dayNumber           Int
  title               String
  bibleStudy          String
  practicalExercise   String
  youthAdvice         String
  reflectionQuestions String
  scripture           String
  createdAt           DateTime     @default(now())
  plan                StrugglePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dayNumber])
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  mood      String
  note      String?
  gratitude String?
  prayer    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  tags      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Streak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActivity  DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Devotional {
  id          String   @id @default(cuid())
  title       String
  scripture   String
  content     String
  prayer      String
  application String
  tags        String
  publishedAt DateTime @default(now())
  isPremium   Boolean  @default(false)
}

model Video {
  id          String      @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  duration    Int?
  category    String
  tags        String?
  publishedAt DateTime    @default(now())
  isPremium   Boolean     @default(false)
  userVideos  UserVideo[]
}

model UserVideo {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  watchedAt DateTime @default(now())
  liked     Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Song {
  id        String   @id @default(cuid())
  title     String
  artist    String
  url       String
  category  String?
  createdAt DateTime @default(now())
}

model DailyPrayer {
  id        String  @id @default(cuid())
  dayOfYear Int     @unique
  title     String
  content   String
  theme     String?
}

model BibleVerse {
  id        String @id @default(cuid())
  reference String
  text      String
  tags      String
  book      String
  chapter   Int
  verseNum  Int
}

model ForumCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  icon        String?
  createdAt   DateTime    @default(now())
  posts       ForumPost[]
}

model ForumPost {
  id            String              @id @default(cuid())
  userId        String
  categoryId    String
  title         String
  content       String
  isAnonymous   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  notifications ForumNotification[]
  category      ForumCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies       ForumReply[]

  @@index([categoryId, createdAt])
}

model ForumReply {
  id          String    @id @default(cuid())
  postId      String
  userId      String
  content     String
  isAnonymous Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Mascot {
  id               String   @id @default(cuid())
  userId           String   @unique
  level            Int      @default(1)
  experience       Int      @default(0)
  flamePoints      Int      @default(0)
  lastFed          DateTime @default(now())
  name             String   @default("Llami")
  mood             String   @default("FELIZ")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastOutfitChange DateTime @default(now())
  outfit           String   @default("none")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TriviaQuestion {
  id           String              @id @default(cuid())
  question     String
  options      String
  correctIndex Int
  explanation  String?
  reference    String?
  difficulty   String              @default("NORMAL")
  attempts     UserTriviaAttempt[]
}

model UserTriviaAttempt {
  id          String         @id @default(cuid())
  userId      String
  questionId  String
  isCorrect   Boolean
  attemptDate DateTime       @default(now())
  question    TriviaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model ForumNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  postId    String
  replyId   String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model ResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tutorial {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  icon        String
  color       String
  href        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  content     String
  isCritical  Boolean   @default(false)
  actionText  String?
  actionUrl   String?
  stats       String?
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  addressee   User     @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester   User     @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model LeaderApplication {
  id        String   @id @default(cuid())
  userId    String
  answers   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String          @id @default(cuid())
  name        String
  description String?
  motto       String?
  leaderId    String
  accessCode  String          @unique
  privacy     String          @default("PRIVATE")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  leader      User            @relation("GroupLeader", fields: [leaderId], references: [id])
  members     GroupMember[]
  needs       GroupNeed[]
  tasks       GroupTask[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}


model GroupTask {
  id          String                @id @default(cuid())
  groupId     String
  title       String
  description String?
  type        String
  date        DateTime
  createdAt   DateTime              @default(now())
  group       Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  completions GroupTaskCompletion[]
}

model GroupTaskCompletion {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  completedAt DateTime  @default(now())
  task        GroupTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model Question {
  id         String         @id @default(cuid())
  userId     String
  title      String
  content    String
  views      Int            @default(0)
  likes      Int            @default(0)
  isTrending Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tags       String?
  answers    Answer[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesList  QuestionLike[]
}

model Answer {
  id         String       @id @default(cuid())
  questionId String
  userId     String
  content    String
  likes      Int          @default(0)
  isAccepted Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesList  AnswerLike[]
}

model QuestionLike {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model AnswerLike {
  id       String @id @default(cuid())
  userId   String
  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, answerId])
}

model GameRoom {
  id                String       @id @default(cuid())
  code              String       @unique
  status            String       @default("WAITING")
  currentTurnUserId String?
  bombExplodesAt    DateTime?
  activeQuestionId  String?
  currentQuestion   String?
  createdAt         DateTime     @default(now())
  isPrivate         Boolean      @default(false)
  name              String?
  type              String       @default("HOT_POTATO")
  players           GamePlayer[]
}

model GamePlayer {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  status   String   @default("ALIVE")
  score    Int      @default(0)
  joinedAt DateTime @default(now())
  room     GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model GameScore {
  id        String   @id @default(cuid())
  userId    String
  gameType  String
  score     Int
  maxScore  Int?
  timeSpent Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameType])
  @@index([gameType, score])
}

model GroupNeed {
  id          String   @id @default(cuid())
  groupId     String
  content     String
  isAnonymous Boolean  @default(true)
  userId      String?
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model PrayerRequest {
  id          String         @id @default(cuid())
  userId      String
  content     String
  isAnonymous Boolean        @default(false)
  isGlobal    Boolean        @default(false)
  prayCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayers     PrayerUpdate[]
}

model PrayerUpdate {
  id        String        @id @default(cuid())
  userId    String
  requestId String
  createdAt DateTime      @default(now())
  request   PrayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String   @unique
  bookIndex Int
  chapter   Int
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

